        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="Welcome to the experiment!&amp;#10;&amp;#10;This experiment aims provide insight into how our brain reacts to different type of emotional visual stimuli. &amp;#10;&amp;#10;You will be asked to complete a task where you respond to visual targets appearing either on the left or right side of the screen. Before each target appears, a cue will be shown, which is either a neutral gaze or an emotional face with the eyes looking in a specific direction.&amp;#10;&amp;#10;Your task is to respond as quickly and accurately as possible when the target dot appears.&amp;#10;&amp;#10;Your participation is anonymous and you are free to withdraw at any time without giving a reason.&amp;#10;&amp;#10;Further instructions will follow after the consent form.&amp;#10;&amp;#10;" valType="str" updates="constant" name="text"/>
        <Param val="height" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
